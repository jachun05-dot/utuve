# 대본 자동 작성: 비워 두면 Claude 구독(Claude Code 로그인)으로 작성해요.
# API 키를 넣으면 API(사용량 과금)로 작성해요. SCRIPT_BACKEND=cli|api 로 강제 지정 가능
ANTHROPIC_API_KEY=
SCRIPT_BACKEND=
# 무료 스톡 영상 (https://www.pexels.com/api/ 에서 무료 발급). 없으면 단색 배경 사용
PEXELS_API_KEY=
# 생성형 AI 영상 (https://fal.ai 가입 후 키 발급, 유료). 없으면 Pexels 사용
FAL_KEY=
# 대본 모델 (기본 claude-opus-5-5)
CLAUDE_MODEL=
